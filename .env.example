APP_NAME=KinderDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tashkent

APP_LOCALE=ru
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=uz_UZ

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Ma'lumotlar bazasi (XAMPP MySQL) ----
# phpMyAdmin'da "kinderdesk" nomli baza yarating (utf8mb4_unicode_ci)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kinderdesk
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ---- Real-time (Laravel Reverb) ----
BROADCAST_CONNECTION=log
REVERB_APP_ID=kinderdesk
REVERB_APP_KEY=kinderdesk-local-key
REVERB_APP_SECRET=kinderdesk-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=log

# ---- Platforma SMS (Eskiz): OTP va direktor ogohlantirishlari ----
# SMS_DRIVER=log  -> SMS yuborilmaydi, kod storage/logs/laravel.log ga yoziladi
# SMS_DRIVER=eskiz -> haqiqiy yuborish
SMS_DRIVER=log
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ---- Payme (Merchant API). Bo'sh bo'lsa faqat karta+chek usuli ishlaydi ----
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
PAYME_TEST_MODE=true
PAYME_ALLOWED_IPS=

# ---- KinderDesk ----
KD_TRIAL_DAYS=14
KD_REMINDER_DAYS=3
KD_DELETE_AFTER_DAYS=90
KD_SUPERADMIN_NAME="Super Admin"
KD_SUPERADMIN_PHONE=998901112233
KD_SUPERADMIN_PASSWORD=ChangeMe!2026
